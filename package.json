{
  "name": "@articulate/asyncios",
  "version": "1.0.2",
  "description": "A wrapper for promise-based library Axios into a crocks Async",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "./dist/",
    "./types/"
  ],
  "repository": "git@github.com:articulate/asyncios.git",
  "author": "Articulate Global, LLC <engineering@articulate.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:all": "conc 'pnpm:check:types' 'pnpm:check:js' 'pnpm:check:fmt'",
    "check:all:fix": "conc 'pnpm:check:types' 'pnpm:check:js:fix' 'pnpm:check:fmt:fix'",
    "check:js": "eslint . --cache --cache-location .cache/eslint/.cache",
    "check:js:fix": "eslint . --fix --cache --cache-location .cache/eslint/.cache",
    "check:fmt": "prettier --log-level warn --check --cache --cache-location .cache/prettier/.cache '**/*.{js,jsx,ts,tsx,json,md,yml,yaml}'",
    "check:fmt:fix": "prettier --log-level warn --write --cache --cache-location .cache/prettier/.cache '**/*.{js,jsx,ts,tsx,json,md,yml,yaml}'",
    "check:types": "tsc --noEmit",
    "prebuild": "rm -rf ./dist",
    "release": "pnpm run build && changeset publish",
    "test": "tsx --test 'test/**/*.test.{js,ts}'"
  },
  "dependencies": {
    "crocks": "^0.12.4"
  },
  "peerDependencies": {
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/utils": "^8.46.4",
    "axios": "^1.13.2",
    "axios-mock-adapter": "^2.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "ts-toolbelt": "^9.6.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.4"
  },
  "packageManager": "pnpm@10.21.0+sha512.da3337267e400fdd3d479a6c68079ac6db01d8ca4f67572083e722775a796788a7a9956613749e000fac20d424b594f7a791a5f4e2e13581c5ef947f26968a40",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
